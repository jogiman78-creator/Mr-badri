<!DOCTYPE html><html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Mr Badri Rewards</title>
<style>
body{font-family:Arial;background:#101827;color:white;text-align:center;padding:20px}
.card{max-width:400px;margin:20px auto;background:#1f2937;padding:20px;border-radius:14px}
input,button{width:100%;box-sizing:border-box;padding:13px;margin:8px 0;border-radius:8px;border:0}
button{background:#16a34a;color:white;font-weight:bold}
button:disabled{background:#777}
a{color:#60a5fa}
</style>
</head>
<body>
<div class="card">
<h1>Welcome to Mr Badri</h1>
<p>Refer and earn rewards</p>
<p><a href="https://www.7a0f8mi.com/#/?invitationCode=2992000774">Open referral link</a></p>
<form id="rewardForm">
<label>UPI ID</label>
<input name="upi" id="upi" placeholder="Enter UPI ID" required>
<label>Game UID</label>
<input name="uid" placeholder="Enter UID" required>
<label>Upload screenshot</label>
<input type="file" name="screenshot" accept="image/png,image/jpeg,image/webp" required>
<label><input type="checkbox" required style="width:auto"> My UID matches the screenshot</label>
<button id="submitBtn" type="submit">Submit UID and Screenshot</button>
<p id="message"></p>
</form>
</div>
<script>
const form=document.getElementById('rewardForm');
const btn=document.getElementById('submitBtn');
const msg=document.getElementById('message');
form.addEventListener('submit',async e=>{
 e.preventDefault();
 if(btn.disabled)return;
 btn.disabled=true;
 btn.textContent='Submitting...';
 msg.textContent='';
 try{
  const r=await fetch('/submit',{method:'POST',body:new FormData(form)});
  const data=await r.json();
  msg.textContent=data.message||'Request complete';
  if(r.ok&&data.success){
   form.reset();
   btn.textContent='Submitted';
  }else{
   btn.disabled=false;
   btn.textContent='Submit UID and Screenshot';
  }
 }catch(err){
  msg.textContent='Network error. Please try again.';
  btn.disabled=false;
  btn.textContent='Submit UID and Screenshot';
 }
});
</script>
</body>
</html>
